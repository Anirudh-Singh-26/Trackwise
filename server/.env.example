PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/trackwise
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
# In production, set COOKIE_SECURE=true and use HTTPS for every CLIENT_ORIGIN.
COOKIE_SECURE=false
# Set this to the exact origin of the unpacked/published Chrome extension if using it.
# Example: EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
EXTENSION_ORIGIN=
# Set true only when deployed behind one trusted reverse proxy.
TRUST_PROXY=false
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# Optional first-run administrator bootstrap. Set both to unique private values or leave both blank.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Screenshot storage: configure these on the backend only; never in the extension.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
